# MARC Camden & Brunswick Line GTFS build pipeline. See PLAN.md for the full design.
#
# Directory roles (see PLAN.md §5):
#   source-pdf/  raw inputs, never written to by this Makefile
#   reference/   data copied from source-pdf and then hand-maintained
#   extracted/   timetable data pulled from the PDFs, hand-verified against source-pdf
#   build/       everything generated by this Makefile (gitignored)

PIXI := pixi run --

# cargo needs a writable registry cache; keep it inside the repo instead of ~/.cargo.
export CARGO_HOME := $(CURDIR)/.cargo-home

.PHONY: all render-pdfs extract-draft diff-sources build validate test clean

all: test build validate

# Unit tests for the trickiest logic in gtfs_builder (cell parsing, AM/PM
# resolution). See gtfs_builder/test_build_gtfs.py.
test:
	$(PIXI) pytest gtfs_builder

# Render every source PDF page to PNG so timetable extraction can be checked by eye.
render-pdfs:
	mkdir -p build/pdf-preview
	$(PIXI) python gtfs_builder/render_pdfs.py --out-dir build/pdf-preview

# Regenerate DRAFT timetable CSVs from the PDFs. Never overwrites the reviewed
# extracted/*.csv files directly -- output goes to extracted/*.draft.csv so manual
# corrections already promoted into extracted/*.csv aren't silently clobbered.
extract-draft:
	$(PIXI) python gtfs_builder/pdf_extract.py --out-dir extracted

# Compare the timetable independently extracted from the brochure PDF against the
# one extracted from the "Changes" PDF, for the same line, and report any mismatch.
diff-sources:
	$(PIXI) python gtfs_builder/diff_sources.py

# Build the GTFS feed from extracted/ + reference/ + gtfs_builder/config.py.
build:
	mkdir -p build/gtfs
	$(PIXI) python gtfs_builder/build_gtfs.py --out-dir build/gtfs --zip build/marc-camden-brunswick-gtfs.zip

# Round-trip parse the built feed with the Rust gtfs-structures crate and check
# referential integrity.
validate: build
	cargo run --manifest-path validator/Cargo.toml -- build/marc-camden-brunswick-gtfs.zip

clean:
	rm -rf build
